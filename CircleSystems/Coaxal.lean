import CircleSystems.PowerOfPoint

/-!
# Coaxal pencils and orthogonal circles

* `pencilPow O₁ R₁ O₂ R₂ t P = (1 − t) · powPt P O₁ R₁ + t · powPt P O₂ R₂`. For each `t` this is
  the power function of a circle (`pencilPow_eq_powPt`), with center `pencilCenter t = (1 − t) O₁ +
  t O₂` on the line of centers and squared radius `pencilRadSq t`; the circles `t ∈ ℝ` form the
  coaxal pencil generated by `(O₁, R₁)` and `(O₂, R₂)`.
* `pencil_radicalAxis`: any two members `s ≠ t` of the pencil have the same radical axis as the
  generating circles (the common radical axis of the pencil).
* `IsOrthogonal O₁ R₁ O₂ R₂`: the circles meet and the radii to a common point are perpendicular.
  `isOrthogonal_iff`: for positive radii this holds iff `powPt O₁ O₂ R₂ = R₁²`, i.e.
  `dist(O₁, O₂)² = R₁² + R₂²`.
* `orthogonal_of_center_on_radicalAxis`: a circle centered on the radical axis of two circles and
  orthogonal to one of them is orthogonal to the other.
-/

open Module
open scoped RealInnerProductSpace

namespace CircleSystems

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- The power function of the member with parameter `t` of the pencil generated by the circles
`(O₁, R₁)` and `(O₂, R₂)`. -/
noncomputable def pencilPow (O₁ : V) (R₁ : ℝ) (O₂ : V) (R₂ : ℝ) (t : ℝ) (P : V) : ℝ :=
  (1 - t) * powPt P O₁ R₁ + t * powPt P O₂ R₂

/-- The center of the member with parameter `t` of the pencil. -/
def pencilCenter (O₁ O₂ : V) (t : ℝ) : V := (1 - t) • O₁ + t • O₂

/-- The squared radius of the member with parameter `t` of the pencil. -/
noncomputable def pencilRadSq (O₁ : V) (R₁ : ℝ) (O₂ : V) (R₂ : ℝ) (t : ℝ) : ℝ :=
  (1 - t) * R₁ ^ 2 + t * R₂ ^ 2 - t * (1 - t) * dist O₁ O₂ ^ 2

/-- Each member of the pencil is a circle: its power function is that of the circle centered at
`pencilCenter O₁ O₂ t` with squared radius `pencilRadSq O₁ R₁ O₂ R₂ t`. -/
theorem pencilPow_eq_powPt (O₁ O₂ : V) (R₁ R₂ t : ℝ) (P : V) :
    pencilPow O₁ R₁ O₂ R₂ t P =
      dist P (pencilCenter O₁ O₂ t) ^ 2 - pencilRadSq O₁ R₁ O₂ R₂ t := by
  simp only [pencilPow, pencilRadSq, pencilCenter, powPt, dist_eq_norm,
    ← real_inner_self_eq_norm_sq, inner_sub_left, inner_sub_right, inner_add_left,
    inner_add_right, real_inner_smul_left, real_inner_smul_right, real_inner_comm O₁ P,
    real_inner_comm O₂ P, real_inner_comm O₁ O₂]
  ring

omit [InnerProductSpace ℝ V] in
/-- The pencil contains the two generating circles. -/
theorem pencilPow_zero (O₁ O₂ : V) (R₁ R₂ : ℝ) (P : V) :
    pencilPow O₁ R₁ O₂ R₂ 0 P = powPt P O₁ R₁ := by simp [pencilPow]

omit [InnerProductSpace ℝ V] in
theorem pencilPow_one (O₁ O₂ : V) (R₁ R₂ : ℝ) (P : V) :
    pencilPow O₁ R₁ O₂ R₂ 1 P = powPt P O₂ R₂ := by simp [pencilPow]

/-- The centers of the pencil lie on the line of centers `O₁O₂`. -/
theorem pencilCenter_mem_line (O₁ O₂ : V) (t : ℝ) :
    pencilCenter O₁ O₂ t ∈ line[ℝ, O₁, O₂] := by
  have : pencilCenter O₁ O₂ t = AffineMap.lineMap O₁ O₂ t := by
    rw [AffineMap.lineMap_apply, pencilCenter, vsub_eq_sub, vadd_eq_add, smul_sub, sub_smul,
      one_smul]
    abel
  rw [this]
  exact AffineMap.lineMap_mem_affineSpan_pair _ _ _

omit [InnerProductSpace ℝ V] in
/-- A point has equal powers with respect to all members of the pencil iff it is on the radical
axis of the generating circles. -/
theorem pencilPow_eq_iff (O₁ O₂ : V) (R₁ R₂ : ℝ) {s t : ℝ} (hst : s ≠ t) (P : V) :
    pencilPow O₁ R₁ O₂ R₂ s P = pencilPow O₁ R₁ O₂ R₂ t P ↔ P ∈ radicalAxis O₁ R₁ O₂ R₂ := by
  simp only [pencilPow, radicalAxis, Set.mem_ofPred_eq]
  have hst' : t - s ≠ 0 := sub_ne_zero.2 hst.symm
  constructor
  · intro h
    have : (t - s) * (powPt P O₁ R₁ - powPt P O₂ R₂) = 0 := by linear_combination h
    exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_left hst')
  · intro h; rw [h]; ring

/-- **Common radical axis of a coaxal pencil.** Any two distinct members of the pencil (viewed as
circles via `pencilPow_eq_powPt`) have the radical axis of the generating circles. -/
theorem pencil_radicalAxis (O₁ O₂ : V) (R₁ R₂ : ℝ) {s t : ℝ} (hst : s ≠ t) :
    {P | dist P (pencilCenter O₁ O₂ s) ^ 2 - pencilRadSq O₁ R₁ O₂ R₂ s =
        dist P (pencilCenter O₁ O₂ t) ^ 2 - pencilRadSq O₁ R₁ O₂ R₂ t} =
      radicalAxis O₁ R₁ O₂ R₂ := by
  ext P
  simp only [Set.mem_ofPred_eq, ← pencilPow_eq_powPt]
  exact pencilPow_eq_iff O₁ O₂ R₁ R₂ hst P

/-- Common points of the generating circles lie on every member of the pencil. -/
theorem pencil_through_common_point {O₁ O₂ X : V} {R₁ R₂ : ℝ} (h₁ : dist X O₁ = R₁)
    (h₂ : dist X O₂ = R₂) (t : ℝ) :
    dist X (pencilCenter O₁ O₂ t) ^ 2 = pencilRadSq O₁ R₁ O₂ R₂ t := by
  have := pencilPow_eq_powPt O₁ O₂ R₁ R₂ t X
  simp only [pencilPow, powPt, h₁, h₂, sub_self, mul_zero, add_zero] at this
  linarith

/-- Two circles are orthogonal: they have a common point at which the radii are perpendicular. -/
def IsOrthogonal (O₁ : V) (R₁ : ℝ) (O₂ : V) (R₂ : ℝ) : Prop :=
  ∃ X : V, dist X O₁ = R₁ ∧ dist X O₂ = R₂ ∧ ⟪X - O₁, X - O₂⟫ = 0

/-- **Orthogonal circles.** In the plane, circles with positive radii are orthogonal iff the power
of the center of the first with respect to the second is the square of the first radius. -/
theorem isOrthogonal_iff [Fact (finrank ℝ V = 2)] {O₁ O₂ : V} {R₁ R₂ : ℝ} (h₁ : 0 < R₁)
    (h₂ : 0 < R₂) : IsOrthogonal O₁ R₁ O₂ R₂ ↔ powPt O₁ O₂ R₂ = R₁ ^ 2 := by
  constructor
  · rintro ⟨X, hX₁, hX₂, hperp⟩
    have h := norm_sub_sq_real (X - O₂) (X - O₁)
    rw [real_inner_comm, hperp, mul_zero, sub_zero, sub_sub_sub_cancel_left] at h
    rw [powPt, dist_eq_norm, h, ← dist_eq_norm, ← dist_eq_norm, hX₁, hX₂]
    ring
  · intro h
    obtain ⟨b⟩ := exists_basis (V := V)
    rw [powPt_coord b] at h
    -- `X = O₁ + α (O₂ − O₁) + β · rot (O₂ − O₁)` with `α = R₁² / d²`, `β = R₁ R₂ / d²`
    obtain ⟨d1, hd1⟩ : ∃ d1, d1 = cx b O₂ - cx b O₁ := ⟨_, rfl⟩
    obtain ⟨d2, hd2⟩ : ∃ d2, d2 = cy b O₂ - cy b O₁ := ⟨_, rfl⟩
    have hd : d1 ^ 2 + d2 ^ 2 = R₁ ^ 2 + R₂ ^ 2 := by rw [hd1, hd2]; linarith
    have hpos : d1 ^ 2 + d2 ^ 2 ≠ 0 := by rw [hd]; positivity
    obtain ⟨α, hα⟩ : ∃ α, α = R₁ ^ 2 / (d1 ^ 2 + d2 ^ 2) := ⟨_, rfl⟩
    obtain ⟨β, hβ⟩ : ∃ β, β = R₁ * R₂ / (d1 ^ 2 + d2 ^ 2) := ⟨_, rfl⟩
    have hα' : α * (d1 ^ 2 + d2 ^ 2) = R₁ ^ 2 := by rw [hα]; field_simp
    have hβ' : β * (d1 ^ 2 + d2 ^ 2) = R₁ * R₂ := by rw [hβ]; field_simp
    set X : V := O₁ + ((α * d1 - β * d2) • b 0 + (α * d2 + β * d1) • b 1)
    have c1 : cx b (X - O₁) = α * d1 - β * d2 := by simp only [X, add_sub_cancel_left, cx_mk]
    have c2 : cy b (X - O₁) = α * d2 + β * d1 := by simp only [X, add_sub_cancel_left, cy_mk]
    have c3 : cx b (X - O₂) = α * d1 - β * d2 - d1 := by
      rw [show X - O₂ = (X - O₁) - (O₂ - O₁) by abel, cx_sub, c1, cx_sub, hd1]
    have c4 : cy b (X - O₂) = α * d2 + β * d1 - d2 := by
      rw [show X - O₂ = (X - O₁) - (O₂ - O₁) by abel, cy_sub, c2, cy_sub, hd2]
    have hs : (d1 ^ 2 + d2 ^ 2) * (d1 ^ 2 + d2 ^ 2) ≠ 0 := mul_ne_zero hpos hpos
    refine ⟨X, ?_, ?_, ?_⟩
    · rw [← sq_eq_sq₀ dist_nonneg h₁.le, dist_eq_norm, norm_sq_coord, c1, c2]
      apply mul_left_cancel₀ hs
      linear_combination (d1 ^ 2 + d2 ^ 2) * ((α * (d1 ^ 2 + d2 ^ 2) + R₁ ^ 2) * hα' +
        (β * (d1 ^ 2 + d2 ^ 2) + R₁ * R₂) * hβ' - R₁ ^ 2 * hd)
    · rw [← sq_eq_sq₀ dist_nonneg h₂.le, dist_eq_norm, norm_sq_coord, c3, c4]
      apply mul_left_cancel₀ hs
      linear_combination (d1 ^ 2 + d2 ^ 2) * ((α * (d1 ^ 2 + d2 ^ 2) + R₁ ^ 2 - 2 * (d1 ^ 2 + d2 ^ 2)) * hα' +
        (β * (d1 ^ 2 + d2 ^ 2) + R₁ * R₂) * hβ' + (d1 ^ 2 + d2 ^ 2 - R₁ ^ 2) * hd)
    · rw [inner_coord, c1, c2, c3, c4]
      apply mul_left_cancel₀ hs
      linear_combination (d1 ^ 2 + d2 ^ 2) * ((α * (d1 ^ 2 + d2 ^ 2) + R₁ ^ 2 - (d1 ^ 2 + d2 ^ 2)) * hα' +
        (β * (d1 ^ 2 + d2 ^ 2) + R₁ * R₂) * hβ' - R₁ ^ 2 * hd)

omit [InnerProductSpace ℝ V] in
/-- Orthogonality expressed symmetrically: `dist(O₁, O₂)² = R₁² + R₂²`. -/
theorem powPt_eq_sq_iff_dist (O₁ O₂ : V) (R₁ R₂ : ℝ) :
    powPt O₁ O₂ R₂ = R₁ ^ 2 ↔ dist O₁ O₂ ^ 2 = R₁ ^ 2 + R₂ ^ 2 := by
  rw [powPt]; constructor <;> intro h <;> linarith

omit [InnerProductSpace ℝ V] in
/-- A circle `(C, r)` whose center lies on the radical axis of `(O₁, R₁)` and `(O₂, R₂)` and which
is orthogonal to the first circle is orthogonal to the second one too. -/
theorem orthogonal_of_center_on_radicalAxis {O₁ O₂ C : V} {R₁ R₂ r : ℝ}
    (hC : C ∈ radicalAxis O₁ R₁ O₂ R₂) (h : powPt C O₁ R₁ = r ^ 2) : powPt C O₂ R₂ = r ^ 2 := by
  rw [← hC]; exact h

end CircleSystems
